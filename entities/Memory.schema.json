{
  "name": "Memory",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "memory_date": {
      "type": "string",
      "format": "date"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "first_time",
        "travel",
        "anniversary",
        "daily",
        "special"
      ]
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "memory_date"
  ]
}